# ---------- PLC (Modbus TCP) ----------
PLC_HOST=192.168.0.5
PLC_PORT=502
MODBUS_UNIT_ID=1
# อ่านทุกกี่มิลลิวินาที
MODBUS_POLL_MS=1000
MODBUS_TIMEOUT_MS=3000
MODBUS_RECONNECT_MS=5000

# ---------- AI1 = ระดับน้ำ 600Q ----------
# ค่าเริ่มต้น FC4 (Read Input Registers) address 0 ตามรูปแบบ LOGO!+AM2 ที่ใช้อยู่ในโปรเจกต์หลัก
# (ดู docs/plc-wiring-logo-am2.md ข้อ 6.2) แต่ PLC ตัวนี้เป็นอุปกรณ์คนละตัว (192.168.0.5)
# ต้องทดสอบอ่านค่าจริงเทียบกับระดับน้ำหน้างานก่อนใช้งานจริงเสมอ แล้วค่อยปรับ ADDRESS/SCALE/OFFSET
AI1_TAG=AI1
AI1_FC=4
AI1_ADDRESS=0
AI1_DATA_TYPE=uint16
AI1_WORD_SWAP=false
AI1_SCALE=1
AI1_OFFSET=0
AI1_MONGO_DB=Tank600Q
AI1_MONGO_COLLECTION=Level Water

# ---------- AI2 = Flowrate 600Q ----------
AI2_TAG=AI2
AI2_FC=4
AI2_ADDRESS=1
AI2_DATA_TYPE=uint16
AI2_WORD_SWAP=false
AI2_SCALE=1
AI2_OFFSET=0
AI2_MONGO_DB=Tank600Q
AI2_MONGO_COLLECTION=Flowrate

# ---------- MongoDB Atlas ----------
# คัดลอกจาก Atlas: Connect > Drivers > Node.js แล้วแทน <password> ด้วยรหัสผ่านของ Database User จริง
MONGODB_URI=
# เก็บข้อมูลดิบไว้กี่วัน เกินกว่านี้ MongoDB ลบทิ้งเองอัตโนมัติ (TTL index) — 0 = ปิด เก็บไว้ตลอดไป
MONGO_RETENTION_DAYS=30
