# ---------- เซิร์ฟเวอร์ ----------
PORT=3000
# URL ที่ผู้ใช้เข้าถึงแอป ใช้ประกอบลิงก์ใน LINE message และ OAuth callback
APP_BASE_URL=http://localhost:3000
# ตั้งเป็น production เมื่อขึ้นจริง (บังคับ cookie Secure)
NODE_ENV=development

# ---------- ความปลอดภัย ----------
# ใช้เซ็น cookie session — ต้องสุ่มใหม่ก่อนขึ้น production
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-before-production
# token ที่ PLC gateway ใช้เรียก POST /api/ingest
INGEST_TOKEN=change-me-ingest-token

# ---------- ฐานข้อมูล ----------
# ถ้าใส่ = ใช้ PostgreSQL จริง / ถ้าเว้นว่าง = ใช้ PGlite (PostgreSQL แบบฝังในแอป เก็บที่ ./data)
# DATABASE_URL=postgres://user:password@localhost:5432/water_monitoring
PGLITE_DIR=./data/pglite

# ---------- สำรองข้อมูลขึ้น Cloudflare R2 (S3-compatible) ----------
# ไม่บังคับ — เว้นว่างไว้ทั้งหมดถ้าไม่ต้องการอัปโหลด backup ขึ้น cloud (เก็บแค่ในเครื่องตามเดิม)
# สร้าง bucket ที่ https://dash.cloudflare.com > R2 แล้วสร้าง API token (R2 > Manage API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# path prefix ใน bucket ที่จะเก็บไฟล์ backup
R2_PREFIX=backups/

# ---------- LINE Login ----------
# https://developers.line.biz/console/ → LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# ต้องตรงกับ Callback URL ที่ตั้งใน console
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/auth/line/callback

# ---------- LINE Messaging API (OA) ----------
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
# ลิงก์เพิ่มเพื่อน OA เช่น https://line.me/R/ti/p/@xxxxxxx
LINE_OA_ADD_FRIEND_URL=
# รูป QR เพิ่มเพื่อน OA — เว้นว่างไว้ ระบบจะใช้ public/img/QRcodeLine.png ถ้ามีไฟล์อยู่
LINE_OA_QR_URL=
# LIFF ID สำหรับปุ่มรับทราบในข้อความ (เว้นว่างได้ ระบบจะใช้ลิงก์เว็บแทน)
LINE_LIFF_ID=

# ---------- Modbus TCP (อ่านจาก PLC โดยตรง ไม่ผ่าน Node-RED) ----------
# เปิดแล้วตัวจำลองจะหยุดอัตโนมัติ เพื่อไม่ให้ค่าปลอมปนกับค่าจริง
MODBUS_ENABLED=false
# อ่านทุกกี่มิลลิวินาที (1000 = 1 วินาที เท่ากับ Poll Rate เดิมใน Node-RED)
MODBUS_POLL_MS=1000
MODBUS_TIMEOUT_MS=3000
MODBUS_RECONNECT_MS=5000

# รองรับหลาย PLC พร้อมกัน — IP/port ของแต่ละ PLC และ address ของแต่ละจุดวัดไม่ได้อยู่ในไฟล์นี้
# แต่เก็บในตาราง plcs/sensors แก้ได้จากหน้า "จุดวัดและ setpoint" โดยไม่ต้องรีสตาร์ตเซิร์ฟเวอร์

# ---------- MongoDB Atlas ----------
# คัดลอกจาก Atlas: Connect > Drivers > Node.js แล้วแทน <password> ด้วยรหัสผ่านของ Database User จริง
# เชื่อมคลัสเตอร์เดียวตาม URI นี้ — database/collection ของแต่ละจุดวัดเลือกจากหน้า "จุดวัดและ setpoint" แทน
MONGODB_URI=

# ---------- โหมดพัฒนา ----------
# เปิดหน้า login ด้วยรหัสพนักงานโดยไม่ผ่าน LINE (ห้ามเปิดใน production)
DEV_LOGIN=true
# สร้างค่าเซนเซอร์จำลองแทน PLC gateway
SIMULATE=true
SIMULATE_INTERVAL_MS=5000

# ---------- เซสชัน ----------
# จำนวนวันที่ไม่มีการใช้งานแล้วจึงหลุดจากระบบ
# ทุกครั้งที่เปิดหน้าจอหรือเรียก API จะเลื่อนวันหมดอายุออกไปอีกเท่านี้
SESSION_IDLE_DAYS=30
